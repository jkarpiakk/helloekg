# helloEKG kurs (https://kurs.helloekg.pl). Na serwerze: /etc/caddy/kurs.caddy, import na końcu /etc/caddy/Caddyfile.
# Od 10.11.2026 bez bramki ?beta=: treść chroni aplikacja (logowanie i potwierdzony e-mail, server/middleware/auth.ts).
# Nagłówki bezpieczeństwa (CSP, HSTS, X-Frame-Options, Referrer-Policy) i noindex/robots.txt ustawia aplikacja
# (server/middleware/security.ts, server/routes.ts, przełącznik INDEKSOWANIE), więc jest jedno źródło prawdy.
kurs.helloekg.pl {
	encode zstd gzip

	# Dziennik żądań (do analizy po teście bezpieczeństwa): bez tokenów z linków w mailach i bez ciasteczek.
	# Adres IP to dana osobowa: 30 dni (polityka prywatności).
	log {
		output file /var/log/caddy/kurs-access.log {
			roll_size 20MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			fields {
				# Jeden filtr na pole (standardowy Caddy nie ma „multiple”), więc jedno wyrażenie robi oba zastąpienia:
				# - klucz weryfikacji zaświadczenia w ścieżce: /zaswiadczenie/<klucz> (strona) i /api/zaswiadczenia/<klucz> (API),
				# - token i session_id w zapytaniu (linki z maili), jak dawny filtr `query`.
				# Niedopasowana grupa w Go regexp daje pusty tekst, więc ${1}${2} działa dla obu gałęzi.
				request>uri regexp "^(/(?:api/)?zaswiadczeni[ae]/)[^/?]+|([?&](?:token|session_id|klucz)=)[^&]*" "${1}${2}REDACTED"
				# Referer niesie adres poprzedniej strony, a ten bywał linkiem z tokenem z maila
				request>headers>Referer delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>Stripe-Signature delete
				resp_headers>Set-Cookie delete
			}
			wrap json
		}
	}

	header -Server

	# TRACE i inne metody spoza aplikacji: 405 zamiast strony SPA (mniej fałszywych alarmów w skanerach)
	@obce not method GET HEAD POST PUT PATCH DELETE OPTIONS
	respond @obce 405

	# Największe żądanie aplikacji to zgłoszenie z 3 zrzutami (ok. 21 MB w JSON); większe odcina Caddy
	request_body {
		max_size 22MB
	}

	# Ankieta przed spotkaniem o EKG (osobny serwis helloekg-ankieta, /opt/helloekg-ankieta)
	@ankieta path /ankieta /ankieta/*
	reverse_proxy @ankieta 127.0.0.1:3200

	reverse_proxy 127.0.0.1:3100

	# Aplikacja nie odpowiada (restart przy wdrożeniu, awaria): zamiast pustej strony 502 strona przerwy
	# w motywie kursu (ops/bledy/przerwa.html, sama ponawia próbę). API dostaje krótki JSON z tym samym kodem,
	# ankieta (osobny serwis) krótki tekst. Plik na serwerze: /var/www/helloekg-bledy/przerwa.html (25.11).
	handle_errors 502 503 504 {
		header Retry-After 10
		header Cache-Control "no-store"
		@api path /api/*
		handle @api {
			header Content-Type "application/json; charset=utf-8"
			respond `{"error":"Kurs chwilowo niedostępny. Spróbuj ponownie za kilka sekund."}` {err.status_code}
		}
		@ankieta_blad path /ankieta /ankieta/*
		handle @ankieta_blad {
			header Content-Type "text/plain; charset=utf-8"
			respond "Ankieta chwilowo niedostępna. Spróbuj ponownie za kilka sekund." {err.status_code}
		}
		handle {
			root * /var/www/helloekg-bledy
			rewrite * /przerwa.html
			templates
			file_server {
				status {err.status_code}
			}
		}
	}
}
