# Copy this file to .env and fill in the values.
# In Replit, set these via the "Secrets" tab (padlock icon in the sidebar).
# Never commit actual secret values to the repository.

# Required — session signing secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# Stripe (płatności). Bez STRIPE_SECRET_KEY płatności są wyłączone (API odpowiada 503).
# Klucze z panelu Stripe → Developers → API keys. Oba z tego samego trybu: sk_test_ z pk_test_ albo sk_live_ z pk_live_.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Sekret podpisu webhooka (panel Stripe → Developers → Webhooks → Signing secret, whsec_…).
# Adres do wpisania w panelu: <APP_BASE_URL>/api/stripe/webhook/manual
# Zdarzenia: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# Adres aplikacji (powroty ze Stripe po płatności, linki w mailach), np. https://kurs.helloekg.pl
APP_BASE_URL=

# Email delivery (SendGrid is preferred — set SENDGRID_API_KEY)
SENDGRID_API_KEY=
FROM_EMAIL=noreply@ekgacademy.pl

# Fallback SMTP (used only when SENDGRID_API_KEY is not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# App URLs
DATABASE_URL=
FRONTEND_URL=https://your-repl-domain.replit.app
