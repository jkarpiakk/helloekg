# Copy this file to .env and fill in the values.
# In Replit, set these via the "Secrets" tab (padlock icon in the sidebar).
# Never commit actual secret values to the repository.

# Required — session signing secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# Required for Stripe payments
TESTING_STRIPE_SECRET_KEY=
TESTING_VITE_STRIPE_PUBLIC_KEY=

# Optional — manual Stripe webhook secret (from Stripe Dashboard → Webhooks → Signing secret).
# Set this when you configure a webhook endpoint manually in the Stripe Dashboard.
# The endpoint URL to register is: https://<your-repl-domain>/api/stripe/webhook/manual
STRIPE_WEBHOOK_SECRET=

# Email delivery (SendGrid is preferred — set SENDGRID_API_KEY)
SENDGRID_API_KEY=
FROM_EMAIL=noreply@ekgacademy.pl

# Fallback SMTP (used only when SENDGRID_API_KEY is not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# App URLs
DATABASE_URL=
FRONTEND_URL=https://your-repl-domain.replit.app
