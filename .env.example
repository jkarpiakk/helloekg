# Konfiguracja kursu helloEKG. Na serwerze: /etc/helloekg-kurs.env (root:kurs, 640).
# Nigdy nie commituj prawdziwych wartości. Sekrety (hasło SMTP, klucze Stripe) wpisuje właściciel na serwerze.

NODE_ENV=production
PORT=3100
DATABASE_URL=
# Sekret podpisu sesji: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# Adres kursu (powroty ze Stripe, linki w mailach, kontrola Origin), np. https://kurs.helloekg.pl
APP_BASE_URL=https://kurs.helloekg.pl
FRONTEND_URL=https://kurs.helloekg.pl

# Grafiki kursu ze studia (serwowane pod /content-assets tylko zalogowanym) i załączniki zgłoszeń
CONTENT_ASSETS_DIR=/var/lib/helloekg-kurs/assets
FEEDBACK_UPLOAD_DIR=/var/lib/helloekg-kurs/feedback

# Indeksowanie w wyszukiwarkach: bez tej zmiennej cały host ma noindex i robots.txt z Disallow (do dnia startu)
# INDEKSOWANIE=1

# Maile transakcyjne (SMTP home.pl, STARTTLS na 587). Odpowiedzi trafiają na REPLY_TO_EMAIL.
SMTP_HOST=helloekg.pl
SMTP_PORT=587
SMTP_USER=kurs@helloekg.pl
SMTP_PASS=
FROM_EMAIL="helloEKG <kurs@helloekg.pl>"
REPLY_TO_EMAIL=kontakt@helloekg.pl

# Płatności. Bez PLATNOSCI_WLACZONE=1 nie ma cennika ani zakupu (trasy checkout: 404), a webhook działa.
# PLATNOSCI_WLACZONE=1
# Klucze Stripe (panel Stripe → Developers → API keys). Oba z tego samego trybu; klucz sk_live_ jest blokowany,
# dopóki nie ma STRIPE_LIVE_DOZWOLONE=1 (checklista przed włączeniem płatności).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Sekret podpisu webhooka (whsec_…). Adres w panelu: <APP_BASE_URL>/api/stripe/webhook/manual
# Zdarzenia: checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded
STRIPE_WEBHOOK_SECRET=
# Metody w Stripe Checkout (każda włączona w panelu Stripe → Settings → Payment methods)
# STRIPE_METODY=card,blik,p24
